APP_NAME=AgentGuard API
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Gateway
LLM_PROVIDER=ollama          # ollama | mock (offline demo / tests)
OLLAMA_URL=http://localhost:11434
ADMIN_TOKEN=dev-admin        # required for PATCH /api/policy and POST /api/approvals/{id}
# POLICY_PATH=../policy.yaml # default: policy.yaml at the repo root
# DATA_DIR=./data            # audit.db + audit.jsonl
