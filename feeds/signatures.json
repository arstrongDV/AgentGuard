    { "id": "INJ-TOOL-DIRECTIVE", "category": "prompt_injection", "severity": "high", "applies_to": ["mcp_result"],
      "pattern": "\\b(call|invoke|execute|run|use)\\s+(the\\s+)?(tool\\s+|function\\s+)?[a-z]+_[a-z_]+\\s*\\(", "description": "Tool result instructing the agent to call a tool (indirect injection)" },
    { "id": "INJ-HTML-COMMENT", "category": "prompt_injection", "severity": "medium", "applies_to": ["mcp_result"],
