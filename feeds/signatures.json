{
  "version": "2026-10-04",
  "signatures": [
    { "id": "EXEC-OS-SYSTEM", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call"],
      "pattern": "\\bos\\.(system|popen|exec[lv]p?e?)\\s*\\(", "description": "Python os.system / os.popen / os.exec* in tool arguments" },
    { "id": "EXEC-SUBPROCESS", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call"],
      "pattern": "\\bsubprocess\\.(run|call|Popen|check_output|check_call)\\b", "description": "Python subprocess call in tool arguments" },
    { "id": "EXEC-EVAL", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call"],
      "pattern": "\\b(eval|exec)\\s*\\(", "description": "eval( / exec( in tool arguments" },
    { "id": "EXEC-DUNDER-IMPORT", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call"],
      "pattern": "__import__\\s*\\(", "description": "Dynamic __import__ in tool arguments" },
    { "id": "EXEC-SHELL-CHAIN", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call"],
      "pattern": "(;|&&|\\|\\|)\\s*(rm|curl|wget|bash|sh|zsh|nc|ncat|python3?|perl|chmod|chown|cat|powershell)\\b", "description": "Shell command chaining with ; && ||" },
    { "id": "EXEC-CMD-SUBSTITUTION", "category": "code_execution", "severity": "high", "applies_to": ["mcp_call"],
      "pattern": "\\$\\([^)]*\\)|`[^`]+`", "description": "Shell command substitution $( ) or backticks" },
    { "id": "EXEC-PIPE-TO-SHELL", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call"],
      "pattern": "\\|\\s*(sudo\\s+)?(ba|z)?sh\\b", "description": "Output piped into a shell" },
    { "id": "EXEC-RM-RF", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call"],
      "pattern": "\\brm\\s+-[a-z]*(rf|fr)[a-z]*\\b", "description": "Recursive forced delete" },
    { "id": "EXEC-REVERSE-SHELL", "category": "code_execution", "severity": "critical", "applies_to": ["mcp_call", "mcp_result"],
      "pattern": "/dev/tcp/|\\bnc\\s+-[ec]\\b|bash\\s+-i\\s+>&", "description": "Reverse shell patterns" },

    { "id": "DESER-REDUCE", "category": "deserialization", "severity": "critical", "applies_to": ["mcp_call", "mcp_result", "llm_in"],
      "pattern": "__reduce(_ex)?__", "description": "Pickle __reduce__ gadget" },
    { "id": "DESER-PICKLE-OPCODES", "category": "deserialization", "severity": "critical", "applies_to": ["mcp_call", "mcp_result"],
      "pattern": "c(os|posix|nt|builtins|__builtin__)(\\n|\\\\n)(system|exec|eval|popen)", "case_sensitive": true, "match_on": "raw",
      "description": "Pickle protocol-0 GLOBAL opcode importing a dangerous callable" },
    { "id": "DESER-PICKLE-LOADS", "category": "deserialization", "severity": "high", "applies_to": ["mcp_call"],
      "pattern": "\\b(c?Pickle|pickle|dill|joblib)\\.loads?\\s*\\(", "description": "Unsafe pickle-family deserialization" },
    { "id": "DESER-TORCH-LOAD", "category": "deserialization", "severity": "high", "applies_to": ["mcp_call"],
      "pattern": "\\btorch\\.load\\s*\\((?![^)]*weights_only\\s*=\\s*True)", "description": "torch.load without weights_only=True" },
    { "id": "DESER-YAML-UNSAFE", "category": "deserialization", "severity": "high", "applies_to": ["mcp_call"],
