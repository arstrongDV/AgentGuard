# Copy to .env (git-ignored) to change the Docker setup. Every value is optional.

# Dashboard port on this machine (5173 by default; pick another if 5173 is taken)
DASHBOARD_PORT=5173

# Admin token for policy edits, approvals and the Attack Lab. CHANGE IT before exposing anything publicly.
ADMIN_TOKEN=dev-admin

# Models Ollama downloads and uses. qwen2.5:3b fits a 4 GB Docker VM; qwen2.5:7b is smarter and needs ~8 GB.
AGENT_MODEL=qwen2.5:3b
JUDGE_MODEL=granite3-guardian:2b

# Use an Ollama app running on this machine instead of the Ollama container (on a Mac: GPU, much faster):
# OLLAMA_URL=http://host.docker.internal:11434
